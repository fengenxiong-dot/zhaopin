APP_ENV=development
APP_NAME=招聘信息管理系统
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_CORS_ORIGINS=http://localhost:8080

POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://recruitment:replace-with-a-strong-password@postgres:5432/recruitment

ATTACHMENT_ROOT=/app/storage/attachments
MAX_ATTACHMENT_SIZE_MB=20
SESSION_COOKIE_NAME=recruitment_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

PUBLIC_PORT=8080
