APP_ENV=development
APP_NAME=招聘信息管理系统
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_CORS_ORIGINS=http://localhost:8080

POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://recruitment:replace-with-a-strong-password@postgres:5432/recruitment

ATTACHMENT_ROOT=/app/storage/attachments
MAX_ATTACHMENT_SIZE_MB=20

PUBLIC_PORT=8080

